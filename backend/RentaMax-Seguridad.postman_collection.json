{
  "info": {
    "name": "RentaMax - Seguridad (Semana 7 Sesion 14)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "tokenOperador",
      "value": ""
    },
    {
      "key": "tokenAdmin",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Sin token -> 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/equipos",
        "description": "Captura 1: ruta protegida sin token.",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Token falso -> 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/equipos",
        "description": "Captura 2: rechazo de token invalido.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJoYWNrZXIiLCJyb2xlIjoiQURNSU5JU1RSQURPUiJ9.firmaFalsa",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Registro con datos invalidos -> 400",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"<script>alert(1)</script>\",\n  \"email\": \"no-es-correo\",\n  \"password\": \"123\"\n}"
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Registro operador -> 201",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "description": "Luego revisar la tabla usuarios: password en formato $2a$10$...",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Carlos Mendoza\",\n  \"email\": \"carlos.mendoza@rentamax.pe\",\n  \"password\": \"RentaMax2026\"\n}"
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Login operador -> 200 (guarda token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"carlos.mendoza@rentamax.pe\",\n  \"password\": \"RentaMax2026\"\n}"
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j = pm.response.json();",
              "if (j.token) pm.collectionVariables.set('tokenOperador', j.token);",
              "pm.test('Login 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Equipos con token -> 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/equipos",
        "description": "Captura 3: acceso exitoso con Bearer Token.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenOperador}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },

{
  "info": {
    "name": "RentaMax - APF2 (BD + Seguridad + Validacion)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar con Collection Runner en orden, contra la URL publica HTTPS (variable baseUrl). Las contrasenas NO estan en la coleccion: importa tambien RentaMax-APF2.postman_environment.json, elige ese Environment y completa passOperador, passSupervisor y passAdmin (tipo secret). Cada peticion verifica ademas que el tiempo de respuesta sea menor a 500 ms (excepto Health, que despierta el servicio en Render)."
  },
  "item": [
    {
      "name": "0. Salud",
      "item": [
        {
          "name": "Health check (API + base de datos)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Publico. Sirve tambien para despertar el servicio en Render antes de la demostracion."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Codigo HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Base de datos conectada', function () { pm.expect(pm.response.json().baseDatos).to.eql('UP'); });"
                ]
              }
            }
          ]
        }
      ]
    },

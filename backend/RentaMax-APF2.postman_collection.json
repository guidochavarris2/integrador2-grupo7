                "api",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"carlos.mendoza@rentamax.pe\",\n  \"password\": \"{{passOperador}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Codigo HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Devuelve un token JWT', function () {",
                  "  var j = pm.response.json();",
                  "  pm.expect(j.token).to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('tokenOperador', j.token);",
                  "});",
                  "pm.test('Rol OPERADOR sin permisos extra', function () { var j = pm.response.json(); pm.expect(j.rol).to.eql('OPERADOR'); pm.expect(j.permisos).to.be.empty; });"
